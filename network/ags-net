#!/bin/sh
# Slot's compatibility entry point; never call a system ags-net fallback.
set -eu
root=${SLOT_ROOT:-/mnt/sdcard}
service="$root/System/slot-services"
export SLOT_OWNER_PID="${SLOT_OWNER_PID:-$PPID}"
# BaseOS's glibc loader also works on cards without executable mode bits.
if [ -f /lib/ld-linux-aarch64.so.1 ]; then
    exec /lib/ld-linux-aarch64.so.1 "$service" "$@"
fi
exec "$service" "$@"
