# Copy to Config/wifi.toml, enter your networks, then turn Home Wi-Fi On in the menu.
# Networks are tried in order. A working connection is retained.
[[networks]]
ssid = "Home"
password = "replace-with-your-password"

[[networks]]
ssid = "Phone hotspot"
password = "replace-with-your-password"

# For an open network, use security = "open" and omit password.
