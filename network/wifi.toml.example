# Copy to System/wifi.toml, enter your networks, then turn Home Wi-Fi On.
# Networks are tried in order. A working connection is retained.
[[networks]]
ssid = "Home"
password = "replace-with-your-password"

[[networks]]
ssid = "Phone hotspot"
password = "replace-with-your-password"

# For an open network, explicitly use security = "open" and omit password.
# Network time sync is automatic; timezone remains utc_offset_min in slot.state.
